{
  "id": "stellaire-d6",
  "title": "Stellaire D6",
  "description": "Système Foundry VTT (V14) pour jouer à « La Croisade Stellaire », un jeu de rôle sur table léger.",
  "version": "0.2.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Capsawk"
    }
  ],
  "url": "https://github.com/Capsawk/stellaire-d6",
  "manifest": "https://github.com/Capsawk/stellaire-d6/releases/latest/download/system.json",
  "download": "https://github.com/Capsawk/stellaire-d6/releases/download/v0.2.0/stellaire-d6.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": ["stellaire.mjs"],
  "styles": [
    "styles/tokens/_palette.css",
    "styles/tokens/_semantic.css",
    "styles/tokens/_motion.css",
    "styles/base/_root.css",
    "styles/base/_forms.css",
    "styles/base/_motion.css",
    "styles/sheets/_actor.css",
    "styles/sheets/_item.css",
    "styles/sheets/_dialog.css",
    "styles/components/_chat-roll.css",
    "styles/components/_chat-item.css",
    "styles/components/_inline-roll.css"
  ],
  "changelog": "CHANGELOG.md",
  "grid": {
    "distance": 1,
    "units": "m"
  },
  "media": [
    {
      "type": "setup",
      "url": "systems/stellaire-d6/assets/cover-stellaire-d6.webp",
      "thumbnail": "systems/stellaire-d6/assets/thumb-stellaire-d6.webp"
    }
  ],
  "documentTypes": {
    "Actor": {
      "personnage": {}
    },
    "Item": {
      "arme": {},
      "armure": {},
      "outil": {},
      "relique": {},
      "equipement": {},
      "capacite": {},
      "pouvoir": {},
      "marque": {},
      "origine": {},
      "role": {}
    }
  },
  "packs": [
    {
      "name": "pretires",
      "label": "Prétirés",
      "system": "stellaire-d6",
      "path": "packs/pretires",
      "type": "Actor"
    },
    {
      "name": "origines",
      "label": "Origines",
      "system": "stellaire-d6",
      "path": "packs/origines",
      "type": "Item"
    },
    {
      "name": "roles",
      "label": "Rôles",
      "system": "stellaire-d6",
      "path": "packs/roles",
      "type": "Item"
    }
  ],
  "packFolders": [
    {
      "name": "Stellaire D6",
      "sorting": "m",
      "packs": ["pretires", "origines", "roles"]
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  },
  "languages": [
    {
      "lang": "fr",
      "name": "Francais",
      "path": "lang/fr.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": false,
  "background": "systems/stellaire-d6/assets/bg-stellaire-d6.webp",
  "primaryTokenAttribute": "rsc.stress"
}