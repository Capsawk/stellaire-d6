<div class="sd6-chat-item">
  <div class="sd6-chat-item-header">
    <img src="{{img}}" title="{{name}}"/>
    <div class="sd6-chat-item-titles">
      <span class="sd6-chat-item-type">{{typeLabel}}</span>
      <h3>{{name}}</h3>
    </div>
  </div>
  {{#if description}}
  <div class="sd6-chat-item-description">{{{description}}}</div>
  {{/if}}
</div>
