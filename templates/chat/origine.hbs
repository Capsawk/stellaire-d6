<div class="sd6-chat-item sd6-chat-origine">
  <div class="sd6-chat-item-header">
    <img src="{{img}}" title="{{name}}"/>
    <div class="sd6-chat-item-titles">
      <span class="sd6-chat-item-type">{{typeLabel}}</span>
      <h3>{{name}}</h3>
    </div>
  </div>
  {{#if description}}
  <div class="sd6-chat-item-description">{{{description}}}</div>
  {{/if}}
  {{#if bonus}}
  <div class="sd6-chat-origine-block bonus">
    <h4>{{localize "SD6.origine.bonus"}}</h4>
    <div class="sd6-chat-origine-text">{{{bonus}}}</div>
  </div>
  {{/if}}
  {{#if malus}}
  <div class="sd6-chat-origine-block malus">
    <h4>{{localize "SD6.origine.malus"}}</h4>
    <div class="sd6-chat-origine-text">{{{malus}}}</div>
  </div>
  {{/if}}
</div>
