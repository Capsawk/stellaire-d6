<div class="stellaire-roll-dialog">
  <p class="roll-dialog-title">{{skillLabel}}</p>

  <div class="roll-pool" data-pool>
    <span class="roll-pool-dice" aria-hidden="true"></span>
    <span class="roll-pool-count"></span>
  </div>

  <div class="form-group">
    <label>{{localize "SD6.jets.position"}}</label>
    <select name="position">{{selectOptions positions selected="risquee"}}</select>
  </div>

  <div class="form-group">
    <label>{{localize "SD6.jets.effet"}}</label>
    <select name="effet">{{selectOptions effets selected="normal"}}</select>
  </div>

  <div class="form-group">
    <label>{{localize "SD6.jets.bonus"}}</label>
    <input type="number" name="bonusDice" value="0" min="0" max="3" step="1" data-dtype="Number"/>
  </div>

  <div class="form-group">
    <label>{{localize "SD6.jets.malus"}}</label>
    <input type="number" name="malusDice" value="0" min="0" max="3" step="1" data-dtype="Number"/>
  </div>

  {{#if effectBonus}}
  <div class="form-group effect">
    <label>{{localize "SD6.jets.effetBonus"}}</label>
    <span class="effect-value">+{{effectBonus}}d6</span>
    <input type="checkbox" name="applyEffectBonus" checked/>
  </div>
  {{#if effectBonusSources}}
  <ul class="effect-sources">
    {{#each effectBonusSources}}
    <li><i class="fas fa-gem"></i> +{{value}}d6 · {{name}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{/if}}

  {{#if effectMalus}}
  <div class="form-group effect">
    <label>{{localize "SD6.jets.effetMalus"}}</label>
    <span class="effect-value">-{{effectMalus}}d6</span>
    <input type="checkbox" name="applyEffectMalus" checked/>
  </div>
  {{#if effectMalusSources}}
  <ul class="effect-sources">
    {{#each effectMalusSources}}
    <li><i class="fas fa-skull"></i> -{{value}}d6 · {{name}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{/if}}

  <div class="form-group">
    <label>{{localize "SD6.jets.gainStress"}}</label>
    <input type="checkbox" name="gainStress" {{#if stressFull}}disabled{{/if}}/>
    <span class="stress-available">{{localize "SD6.rsc.stress"}} : {{stress}}/{{stressMax}}</span>
  </div>

  <footer class="sheet-footer">
    <button type="submit"><i class="fa-solid fa-dice-d6"></i> {{localize "SD6.jets.roll"}}</button>
  </footer>
</div>
